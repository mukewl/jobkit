{
  "_comment": "Copy to config.json and edit. config.json is gitignored.",
  "location": "France",
  "experience_years": 4,
  "timezone": "Europe/Paris",
  "_boards_note": "Boards you search yourself. Run the search on the site in your browser, copy the resulting URL, and paste it here. /find-jobs opens each one, reads the results, and folds them in with everything else. You are responsible for the terms of any site you add.",
  "boards": [
    {
      "name": "Example Board",
      "search_url": "https://example.com/jobs?q=growth+marketing&l=Paris",
      "enabled": false
    }
  ],
  "_sources_note": "API sources, no browser needed. himalayas = remote worldwide. arbeitnow = Europe and UK with a visa-sponsorship flag. csv_import = any file you export yourself. Add your own: search/sources/README.md",
